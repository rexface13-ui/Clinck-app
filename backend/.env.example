APP_NAME=DentaFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
DISPLAY_TIMEZONE=Asia/Hebron
SANCTUM_STATEFUL_DOMAINS=localhost:5183,127.0.0.1:5183

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dentaflow
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@dentaflow.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# From @BotFather — leave empty locally until a bot is created
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Used by the Settings page "تحديث النظام" button (and installer\update.bat)
# to pull the latest code for THIS customer's deploy repo. Fine-grained PAT,
# read-only, scoped to that one repo only — never the main dev repo's token.
GITHUB_UPDATE_REPO=
GITHUB_UPDATE_TOKEN=

# Used by the "نشر آخر تقرير الآن" button on Settings to publish the daily
# closing report via the GitHub Contents API (no local git involved at all —
# see ReportPublishService). Must be a SEPARATE, dedicated, public repo (e.g.
# "YousefClinic-Reports") with GitHub Pages free for public repos only, and
# never the clinic's actual code repo. Fine-grained PAT scoped to that one
# repo, Contents + Pages: Read & write.
GITHUB_REPORTS_REPO=
GITHUB_REPORTS_TOKEN=
